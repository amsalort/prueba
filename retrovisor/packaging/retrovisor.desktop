[Desktop Entry]
Type=Application
Name=RetroVisor
GenericName=Visor de imágenes
GenericName[en]=Image Viewer
Comment=Visor y explorador de imágenes rápido con interfaz clásica
Comment[en]=Fast image viewer and browser with a classic interface
Exec=retrovisor %F
Icon=retrovisor
Terminal=false
Categories=Graphics;Viewer;RasterGraphics;2DGraphics;Photography;
Keywords=imagen;foto;visor;miniaturas;presentación;mozjpeg;image;photo;viewer;thumbnail;slideshow;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/tiff;image/webp;image/x-pcx;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-icon;image/vnd.microsoft.icon;image/x-xbitmap;image/x-xpixmap;image/vnd.adobe.photoshop;image/avif;image/heif;image/heic;image/jp2;image/svg+xml;image/x-sgi;image/x-sun-raster;image/vnd-ms.dds;image/x-icns;inode/directory;
StartupWMClass=RetroVisor
Actions=Slideshow;

[Desktop Action Slideshow]
Name=Presentación
Exec=retrovisor --slideshow %F
